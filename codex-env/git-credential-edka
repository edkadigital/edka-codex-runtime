#!/usr/bin/env bash
set -euo pipefail

operation="${1:-}"
if [[ "${operation}" != "get" ]]; then
    exit 0
fi

protocol=""
host=""
while IFS='=' read -r key value; do
    value="${value%$'\r'}"
    case "${key}" in
        protocol) protocol="${value}" ;;
        host) host="${value}" ;;
    esac
done

# This helper holds a repository-scoped GitHub installation token. Never
# disclose it to another HTTPS origin if a tool invokes Git's credential
# machinery for an unrelated remote.
if [[ "${protocol,,}" != "https" || "${host,,}" != "github.com" ]]; then
    exit 0
fi

token_file="${GITHUB_TOKEN_FILE:-/var/run/edka/github/token}"
if [[ ! -s "${token_file}" ]]; then
    echo "GitHub token file is missing or empty" >&2
    exit 1
fi

printf 'username=x-access-token\n'
printf 'password='
tr -d '\r\n' <"${token_file}"
printf '\n\n'
