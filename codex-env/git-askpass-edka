#!/usr/bin/env bash
set -euo pipefail

token_file="${GITHUB_TOKEN_FILE:-/var/run/edka/github/token}"
case "${1:-}" in
    *Username* | *username*)
        printf '%s\n' "x-access-token"
        ;;
    *Password* | *password*)
        if [[ ! -s "${token_file}" ]]; then
            echo "GitHub token file is missing or empty" >&2
            exit 1
        fi
        tr -d '\r\n' <"${token_file}"
        printf '\n'
        ;;
    *)
        printf '\n'
        ;;
esac
